<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <!-- GitHub (EvangeOS) -->
  <remote  name="evange"
           fetch="https://github.com/EvangeProject/"
           revision="asuka-14" />

   <!-- GitHub (fork-EvangeOS) -->
  <remote  name="evange"
           fetch="https://github.com/LineageOS/"
           revision="asuka-14f" />
  
  <!-- Gitlab (fork-EverestOS) -->
  <remote  name="everest-gitlab"
           fetch="https://gitlab.com/everestos/"
           revision="14" />

   <!-- Gitea (fork-EverestOS) -->
  <remote  name="everest-gitea"
           fetch="https://gitea.com/ProjectEverest/"
           revision="14" />

  <!-- Rootdir -->
  <project path="manifest" name="manifest" remote="asuka-14" />

  <!-- Build -->
  <project path="build/make" name="build" groups="pdk,sysui-studio" remote="asuka-14" >
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>

  <project path="build/soong" name="build_soong" groups="pdk,tradefed" remote="asuka-14" >
    <linkfile src="root.bp" dest="Android.bp" />
    <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>

  <!-- Bootable -->
  <project path="bootable/recovery" name="bootable_recovery" groups="pdk" remote="asuka-14" />

  <!-- Frameworks -->
  <project path="frameworks/av" name="frameworks_av" groups="pdk" remote="asuka-14f" />
   <project path="frameworks/opt/telephony" name="frameworks_opt_telephony" groups="pdk" remote="asuka-14f" />
  <project path="frameworks/base" name="frameworks_base" groups="pdk-cw-fs,pdk-fs" remote="asuka-14f" />
  <project path="frameworks/libs/systemui" name="frameworks_libs_systemui" remote="asuka-14f" />
  <project path="frameworks/native" name="frameworks_native" groups="pdk-cw-fs,pdk-fs" remote="asuka-14f" />

  <!-- Packages -->
   <project path="packages/apps/setupwizard" name="packages_apps_SetupWizard" remote="asuka-14" />
  <project path="packages/apps/Settings" name="packages_apps_Settings" groups="pdk-fs" remote="asuka-14" />

  <!-- SDK -->
  <project path="lineage-sdk" name="lineage-sdk" remote="asuka-14" />

  <!-- System -->
  <project path="system/core" name="system_core" groups="pdk" remote="asuka-14" />
  <project path="system/sepolicy" name="system_sepolicy" groups="pdk" remote="asuka-14f" />

  <!-- Vendor -->
  <project path="vendor/gms" name="vendor_gms" remote="everest-gitea" clone-depth="1" />
</manifest>

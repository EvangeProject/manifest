<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <!-- GitHub (EvangeOS) -->
  <remote  name="asuka-14"
           fetch="https://github.com/EvangeProject/"
           revision="asuka-14" />
  
  <!-- Gitlab (fork-EverestOS) -->
  <remote  name="everest-gitlab"
           fetch="https://gitlab.com/everestos/"
           revision="14" />

   <!-- Gitea (fork-EvolutionX) -->
 <remote  name="evo-bitbucket"
           fetch="https://bitbucket.org/evo-x"
           sync-c="true"
           sync-j="4"
           revision="refs/heads/udc" />

  <!-- Rootdir -->
  <project path="manifest" name="manifest" remote="asuka-14" />

  <!-- Build -->

  <!-- Bootable -->
  <project path="bootable/recovery" name="bootable_recovery" groups="pdk" remote="asuka-14" />
  

  <!-- Packages -->
  <project path="packages/apps/Settings" name="packages_apps_settings" groups="pdk-fs" remote="asuka-14" />

  <!-- Vendor -->
   <project path="vendor/evange" name="vendor_evange" groups="pdk" remote="asuka-14" />
  <project path="vendor/gms" name="vendor_gms" remote="evo-bitbucket" clone-depth="1" />
<!-- Devices -->
  <project path="oficialdevices" name="official_devices" remote="asuka-14" />
  
</manifest>
